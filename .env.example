# StockPulse Environment Configuration
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# Database
DATABASE_URL=postgres://stockpulse:stockpulse_secret@localhost:5432/stockpulse
POSTGRES_DB=stockpulse
POSTGRES_USER=stockpulse
POSTGRES_PASSWORD=stockpulse_secret

# AI Service
AI_SERVICE_URL=http://localhost:8000

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=3001

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001

# JWT Auth
JWT_SECRET=stockpulse-super-secret-jwt-key-change-in-production

# News API (for sentiment analysis)
NEWS_API_KEY=your_news_api_key_here

# API Key Encryption (32-byte key will be derived via SHA-256)
API_KEY_ENCRYPTION_KEY=stockpulse-default-api-key-encryption-key

# ── AI Chat (server-configured) ─────────────────────────
# Provider: claude | chatgpt | gemini | deepseek | groq | glm
AI_PROVIDER=glm
# Your AI API key (for Zhipu/GLM it's the "id.secret" format)
AI_API_KEY=your_ai_api_key_here
# Model name (e.g. glm-5.2, gpt-4o-mini, gemini-2.0-flash, deepseek-chat)
AI_MODEL=glm-5.2

# ── AI Analisis (Ollama, lokal) ─────────────────────────
# Dipakai oleh frontend (Next.js server) untuk SEMUA analisis AI:
# Ringkasan, Fundamental, Harga Wajar, Rekomendasi AI, Profil, dan Chat AI.
# Lokal & gratis — tidak butuh API key. Jalankan: `ollama pull qwen2.5:7b`
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# Catatan Docker: jika frontend berjalan di container, gunakan
# OLLAMA_BASE_URL=http://host.docker.internal:11434

